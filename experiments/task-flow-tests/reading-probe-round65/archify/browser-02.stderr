visible source [ 'js', "   const storedReviews=original.human?.reviews??[];\n   if(receipt.delivery.status==='delivered')for(const review of storedReviews)receipt=attachHumanReview(receipt,review);\n   else if(storedReviews.length)evidence.missing.push('stored human reviews not bound: final artifact unavailable');", "   const storedReviews=original.human?.reviews??[];\n   if(receipt.delivery.status==='delivered')for(const review of storedReviews)receipt=attachHumanReview(receipt,review);\n   else if(storedReviews.length)evidence.missing.push('stored human reviews not bound: final artifact unavailable');", 'js', ' const defects={evidenceMissing:evidence.missing??[],semanticMeasurements:row.semanticMeasurements??null,semanticDefects:row.semanticDefects??[],layoutDetails:row.layoutDetails??null,sourceEvidence:row.sourceEvidence??null,missing:row.missing??[],human:row.human??null};', ' const defects={evidenceMissing:evidence.missing??[],semanticMeasurements:row.semanticMeasurements??null,semanticDefects:row.semanticDefects??[],layoutDetails:row.layoutDetails??null,sourceEvidence:row.sourceEvidence??null,missing:row.missing??[],human:row.human??null};', 'js', "test('stored ratings with a missing artifact do not abort the comparison or gain human credit',async t=>{\n const dir=temp(t),{plan,write}=comparisonFixture(dir);\n const receipt=JSON.parse(fs.readFileSync(path.join(dir,'base.json')));\n receipt.human={status:'completed',reviews:[{taskId:'one',artifactHash:receipt.artifactHash,status:'completed',reviewerId:'historical-rater',rubricVersion:'diagram-quality-human-v1',independent:true,ratings:{readability:4,hierarchy:4,layout:4,style:4,aesthetics:4}}]};\n write('base.json',receipt);delete plan.runs[0].artifact;write('plan.json',plan);\n const {comparison}=await compareFromFiles({plan:path.join(dir,'plan.json'),output:path.join(dir,'out')});\n const row=comparison.pairs[0].base;\n assert.equal(row.delivery.status,'unverified');assert.equal(row.scores.human,null);\n assert.ok(row.evidence.missing.some(reason=>reason.includes('stored human reviews')));\n assert.ok(fs.existsSync(path.join(dir,'out/index.html')));\n});", "test('stored ratings with a missing artifact do not abort the comparison or gain human credit',async t=>{\n const dir=temp(t),{plan,write}=comparisonFixture(dir);\n const receipt=JSON.parse(fs.readFileSync(path.join(dir,'base.json')));\n receipt.human={status:'completed',reviews:[{taskId:'one',artifactHash:receipt.artifactHash,status:'completed',reviewerId:'historical-rater',rubricVersion:'diagram-quality-human-v1',independent:true,ratings:{readability:4,hierarchy:4,layout:4,style:4,aesthetics:4}}]};\n write('base.json',receipt);delete plan.runs[0].artifact;write('plan.json',plan);\n const {comparison}=await compareFromFiles({plan:path.join(dir,'plan.json'),output:path.join(dir,'out')});\n const row=comparison.pairs[0].base;\n assert.equal(row.delivery.status,'unverified');assert.equal(row.scores.human,null);\n assert.ok(row.evidence.missing.some(reason=>reason.includes('stored human reviews')));\n assert.ok(fs.existsSync(path.join(dir,'out/index.html')));\n});" ]
