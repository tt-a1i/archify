      "label": "Object store",
      "sublabel": "S3 multipart"
    },
    {
      "id": "scan",
      "type": "backend",
      "label": "Virus scan",
      "sublabel": "ClamAV"
    },
    {
      "id": "db",
      "type": "database",
      "label": "Metadata DB",
      "sublabel": "Postgres"
    }
  ],
  "messages": [
    {
      "id": "m1",
      "from": "client",
      "to": "api",
      "y": 160,
      "label": "POST /uploads (size, name)"
