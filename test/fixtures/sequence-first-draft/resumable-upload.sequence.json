    {
      "id": "m2",
      "from": "api",
      "to": "s3",
      "y": 192,
      "label": "CreateMultipartUpload"
    },
    {
      "id": "m3",
      "from": "s3",
      "to": "api",
      "y": 224,
      "label": "uploadId",
      "variant": "return"
    },
    {
      "id": "m4",
      "from": "api",
      "to": "client",
      "y": 256,
      "label": "201 Location",
      "variant": "return"
    },
    {
      "id": "m5",
      "from": "client",
      "to": "api",
      "y": 300,
      "label": "PATCH chunk 1..n"
    },
    {
      "id": "m6",
      "from": "api",
      "to": "s3",
      "y": 328,
      "label": "UploadPart",
      "variant": "dashed"
    },
    {
      "id": "m7",
      "from": "client",
      "to": "api",
      "y": 356,
      "label": "HEAD (resume offset)"
    },
    {
      "id": "m8",
      "from": "api",
      "to": "s3",
      "y": 392,
      "label": "CompleteMultipartUpload"
    },
    {
      "id": "m9",
      "from": "api",
      "to": "scan",
      "y": 420,
      "label": "scan object",
      "variant": "dashed"
    },
    {
      "id": "m10",
      "from": "scan",
      "to": "api",
      "y": 448,
      "label": "clean",
      "variant": "return"
    },
    {
      "id": "m11",
      "from": "api",
      "to": "db",
      "y": 476,
      "label": "insert file row"
    },
    {
      "id": "m12",
      "from": "api",
      "to": "client",
      "y": 504,
      "label": "204 done",
      "variant": "return"
    }
  ],
  "segments": [
    {
      "from": 140,
      "to": 280,
      "label": "Create"
    },
    {
      "from": 286,
      "to": 370,
      "label": "Transfer + resume"
