{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Resumable file upload",
    "locale": "en",
    "quality_profile": "showcase",
    "output": "resumable-upload.html"
  },
  "participants": [
    {
      "id": "client",
      "type": "frontend",
      "label": "Client",
      "sublabel": "web uploader"
