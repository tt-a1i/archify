        {
          "name": "id",
          "type": "bigint",
          "key": "pk"
        },
        {
          "name": "email",
          "type": "varchar(255)",
          "key": "uk"
        },
        {
          "name": "name",
          "type": "varchar(120)"
        },
        {
          "name": "created_at",
          "type": "timestamptz"
        }
      ]
    },
    {
      "id": "addresses",
      "label": "addresses",
      "tag": "accounts",
      "row": 1,
      "col": 0,
      "attributes": [
        {
          "name": "id",
          "type": "bigint",
          "key": "pk"
        },
        {
          "name": "customer_id",
          "type": "bigint",
          "key": "fk",
          "references": "customers.id"
        },
        {
          "name": "line1",
          "type": "varchar(200)"
