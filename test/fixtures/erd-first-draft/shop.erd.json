        {
          "name": "city",
          "type": "varchar(80)"
        },
        {
          "name": "postcode",
          "type": "varchar(16)"
        }
      ]
    },
    {
      "id": "orders",
      "label": "orders",
      "tag": "sales",
      "row": 0,
      "col": 1,
      "attributes": [
        {
          "name": "id",
          "type": "bigint",
          "key": "pk"
        },
        {
          "name": "customer_id",
          "type": "bigint",
          "key": "fk",
          "references": "customers.id"
        },
        {
          "name": "shipping_address_id",
          "type": "bigint",
          "key": "fk",
          "references": "addresses.id"
        },
        {
          "name": "status",
          "type": "varchar(20)"
        },
        {
          "name": "total",
          "type": "numeric(12,2)"
        },
        {
          "name": "placed_at",
          "type": "timestamptz"
        }
      ]
    },
    {
