  "relationships": [
    {
      "id": "addresses_customers",
      "from": "addresses",
      "to": "customers",
      "fromCardinality": "many",
      "toCardinality": "one",
      "label": "belongs to"
    },
    {
      "id": "orders_customers",
      "from": "orders",
      "to": "customers",
      "fromCardinality": "many",
      "toCardinality": "one",
      "label": "placed by"
    },
    {
      "id": "orders_addresses",
      "from": "orders",
      "to": "addresses",
      "fromCardinality": "many",
      "toCardinality": "one",
      "label": "ships to"
    },
    {
      "id": "order_items_orders",
      "from": "order_items",
      "to": "orders",
      "fromCardinality": "many",
      "toCardinality": "one",
      "label": "line of",
      "identifying": true
    },
    {
      "id": "order_items_products",
      "from": "order_items",
      "to": "products",
      "fromCardinality": "many",
      "toCardinality": "one",
      "label": "sells",
      "identifying": true
    },
    {
      "id": "payments_orders",
      "from": "payments",
      "to": "orders",
      "fromCardinality": "many",
      "toCardinality": "one",
      "label": "pays",
      "fromOptional": true
    },
    {
      "id": "products_categories",
      "from": "products",
      "to": "categories",
      "fromCardinality": "many",
      "toCardinality": "one",
      "label": "in category"
    }
  ]
