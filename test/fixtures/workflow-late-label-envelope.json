  "cards": [
    {
      "dot": "cyan",
      "title": "各自的职责",
      "items": [
        "Agent 理解需求、追踪源码、选择图类型并编写候选 JSON。",
        "Workflow 编译器根据节点与连线计算布局；交付过程渲染并检查 HTML。"
      ]
    },
    {
      "dot": "amber",
      "title": "不要混淆检查",
      "items": [
        "finalize 在首个失败阶段停止；根据诊断修复候选并重新执行完整流程。",
        "浏览器自动检查不产生截图，也不代表视觉审阅；需要审阅时运行 visual-check 并检查截图。"
      ]
    }
