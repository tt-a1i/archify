  "connections": [
    {
      "id": "browser-to-api",
      "from": "browser",
      "to": "api",
      "label": "REST / SSE"
    },
    {
      "id": "api-to-agent",
      "from": "api",
      "to": "agent",
      "label": "受信附件身份"
    },
    {
      "id": "agent-to-llm",
      "from": "agent",
      "to": "llm",
      "label": "流式回答"
    },
    {
      "id": "api-to-context",
      "from": "api",
      "to": "context",
      "label": "事实检索"
    },
    {
      "id": "agent-to-context",
      "from": "agent",
      "to": "context",
      "label": "证据检索"
    },
    {
      "id": "api-to-cache",
      "from": "api",
      "to": "cache",
      "label": "读取缓存"
    },
    {
      "id": "sources-to-worker",
      "from": "sources",
      "to": "worker",
      "label": "定时采集"
    },
    {
      "id": "worker-to-context",
      "from": "worker",
      "to": "context",
      "label": "写入证据"
    },
    {
      "id": "worker-to-cache",
      "from": "worker",
      "to": "cache",
      "label": "刷新 last-good"
    }
  ],
  "boundaries": [
    {
      "kind": "region",
      "label": "后端服务",
