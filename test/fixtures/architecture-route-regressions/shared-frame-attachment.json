      "size": [
        150,
        64
      ]
    },
    {
      "id": "sources",
      "type": "external",
      "label": "公开数据源",
      "sublabel": "外部公开数据",
      "size": [
        150,
        64
      ]
    },
    {
      "id": "worker",
      "type": "backend",
      "label": "采集 Worker",
      "sublabel": "定时采集任务",
      "size": [
        150,
        64
      ]
    },
    {
      "id": "cache",
      "type": "database",
      "label": "Redis",
      "sublabel": "缓存 / last-good",
      "size": [
        150,
        64
      ]
    },
    {
      "id": "context",
      "type": "database",
      "label": "World Context",
      "sublabel": "PostgreSQL + PostGIS",
      "size": [
        170,
        64
      ]
    },
    {
      "id": "archive",
      "type": "database",
      "label": "历史证据归档",
