  "cards": [
    {
      "dot": "amber",
      "title": "确认职责",
      "items": [
        "CLI：预览后在终端输入 confirm；取消不执行。",
        "JSON：无交互提示，调用方在执行前负责取得明确确认。"
      ]
    },
    {
      "dot": "cyan",
      "title": "状态与恢复",
      "items": [
        "扫描保存快照与索引；Plan、Receipt 和治理状态存入 SQLite。",
        "文件操作日志记录指纹、补偿和恢复信息；成功 Apply 后重扫。",
        "计划过期或来源不足时先重扫并重新准备；恢复未解决时阻止后续变更。"
      ]
    }
