          <h2 class="section-heading" data-i18n="types-h2">Ten questions. <em>Ten kinds of map.</em></h2>
        </div>
        <p class="section-body" data-i18n="types-body">Ask the question you have. Archify picks the picture that answers it, whether it is a system, a database, an incident or your own plans.</p>
      </header>

      <div class="types-index">
        <div class="types-col">
        <ol class="types-list" id="types-list">
          {diagramTypes.map(([key, kind, question], index) => (
            <li class={index === 0 ? 'type-item is-active' : 'type-item'} data-type={key}>
              <button type="button" aria-controls="type-preview" aria-pressed={index === 0 ? 'true' : 'false'}>
                <span class="type-no">{String(index + 1).padStart(2, '0')}</span><span class="type-name"><small class="type-kind" data-i18n={`${key}-k`}>{kind}</small><span data-i18n={`${key}-h`}>{question}</span></span>
              </button>
            </li>
