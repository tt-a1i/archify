  <!-- TRUST — the four finalize gates beside a replay of a real run (output and receipt values are verbatim) -->
  <section id="trust">
    <div class="container">
      <header class="section-head section-head-row fade-up">
        <div>
          <p class="section-label"><span>03</span><span data-i18n="label-trust">Verified delivery</span></p>
          <h2 class="section-heading" data-i18n="trust-h2">Checked before <em>it reaches you.</em></h2>
        </div>
        <p class="section-body" data-i18n="trust-body">Finalize validates and delivers the artifact, then checks the file it delivered. A failed render never replaces the last good one.</p>
      </header>
      <div class="trust-layout" id="trust-run">
        <ol class="gates">
          <li class="gate" style="--d:1.5s"><span class="gate-no">01</span><div><h3><code>validate</code><span data-i18n="gate-1-h">The source means what it says</span></h3><p data-i18n="gate-1-p">Schema and references, then the layout itself: crossings, label clearance and legend room.</p></div><span class="gate-pass">PASS</span></li>
          <li class="gate" style="--d:2.3s"><span class="gate-no">02</span><div><h3><code>deliver</code><span data-i18n="gate-2-h">Nothing half-written</span></h3><p data-i18n="gate-2-p">Rendered beside the target and swapped in atomically, so a failed render leaves your file as it was.</p></div><span class="gate-pass">PASS</span></li>
          <li class="gate" style="--d:2.9s"><span class="gate-no">03</span><div><h3><code>check</code><span data-i18n="gate-3-h">The file is the one that was checked</span></h3><p data-i18n="gate-3-p">The delivered HTML is read back and checked again; the receipt records its hash.</p></div><span class="gate-pass">PASS</span></li>
          <li class="gate" style="--d:3.6s"><span class="gate-no">04</span><div><h3><code>browser-check</code><span data-i18n="gate-4-h">Readable in a real browser</span></h3><p data-i18n="gate-4-p">Chrome checks overflow and text size at several desktop sizes. Opt-in for one-page answers.</p></div><span class="gate-pass">PASS</span></li>
        </ol>
        <figure class="run">
          <div class="run-bar"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="run-title">finalize · cache-miss</span></div>
          <div class="run-body">
            <p class="t-line t-cmd" style="--d:0s"><span aria-hidden="true">$ </span>archify finalize sequence cache-miss.json cache-miss.html --browser-check</p>
            <p class="t-line t-ok" style="--d:3.9s">finalize pass: cache-miss.html</p>
            <p class="t-line" style="--d:4.05s">gates <b>validate:pass</b> <b>deliver:pass</b> <b>check:pass</b> <b>browser-check:pass</b></p>
            <p class="t-line" style="--d:4.2s">receipt cache-miss.finalize.json</p>
          </div>
          <div class="receipt-sum">
            <p class="sum-head" data-i18n="sum-head">From the receipt</p>
            <div class="sum-row"><span class="sum-k">check</span><span class="sum-v"><b>9/9</b><span class="chips"><i style="--d:1.6s">single_svg</i><i style="--d:1.7s">finite_svg</i><i style="--d:1.8s">orthogonal_arrows</i><i style="--d:1.9s">label_route_clearance</i><i style="--d:2s">relationship_crossings</i><i style="--d:2.1s">relationship_corridors</i><i style="--d:2.2s">container_border_runs</i><i style="--d:2.3s">route_rhythm</i><i style="--d:2.4s">legend_clearance</i></span></span></div>
            <div class="sum-row"><span class="sum-k">browser</span><span class="sum-v"><span class="chips"><i style="--d:3s">1440×900</i><i style="--d:3.15s">1600×1000</i><i style="--d:3.3s">1920×1080</i><i style="--d:3.45s">2048×1320</i></span><small data-i18n="sum-text">smallest node text 7 px · required 6 px</small></span></div>
            <div class="sum-row"><span class="sum-k">sha256</span><span class="sum-v"><code>252f687dbe79fbf9…</code></span></div>
          </div>
        </figure>
      </div>
    </div>
  </section>

  <!-- QUICK START -->
  <section id="quickstart">
    <div class="container">
      <header class="section-head section-head-row fade-up">
        <div>
          <p class="section-label"><span>04</span><span data-i18n="label-qs">Quick start</span></p>
          <h2 class="section-heading" data-i18n="qs-h2">Three steps. <em>One command.</em></h2>
        </div>
        <p class="section-body" data-i18n="qs-body">One checked Skill for Claude Code, Codex, Cursor, OpenCode, and GitHub Copilot. Pick your agent for the exact command.</p>
      </header>

      <div class="qs-layout">
        <div class="terminal fade-up">
          <div class="terminal-bar">
            <div class="agent-tabs" role="tablist" aria-label="Choose your agent">
              <button type="button" role="tab" aria-selected="true" tabindex="0" data-agent="claude-code">Claude Code</button>
              <button type="button" role="tab" aria-selected="false" tabindex="-1" data-agent="codex">Codex</button>
              <button type="button" role="tab" aria-selected="false" tabindex="-1" data-agent="cursor">Cursor</button>
              <button type="button" role="tab" aria-selected="false" tabindex="-1" data-agent="opencode">OpenCode</button>
              <button type="button" role="tab" aria-selected="false" tabindex="-1" data-agent="github-copilot">Copilot</button>
            </div>
          </div>
          <div class="terminal-body" role="tabpanel">
            <p class="install-cmt" data-i18n="term-c1"># Install globally for your agent</p>
            <div class="install-line">
              <p class="install-cmd"><span aria-hidden="true">$ </span><code id="agent-command">{installCommand}</code></p>
              <button class="cmd-copy" type="button" data-copy-from="agent-command" aria-label="Copy install command">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><rect x="4.5" y="4.5" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="1.3"/><path d="M9.5 4.5V3A1.5 1.5 0 0 0 8 1.5H3A1.5 1.5 0 0 0 1.5 3v5A1.5 1.5 0 0 0 3 9.5h1.5" stroke="currentColor" stroke-width="1.3"/></svg>
                <span class="cmd-copy-label" data-i18n="copy">Copy</span>
              </button>
            </div>
            <p class="install-cmt" data-i18n="term-c2"># Or try it once with Codex, no permanent install</p>
            <p class="install-cmd"><span aria-hidden="true">$ </span><code>npx skills use tt-a1i/archify@archify --agent codex</code></p>
            <p class="install-cmt" data-i18n="term-c3"># Then just ask</p>
            <p class="install-ask" data-i18n="term-ask">› Use Archify to plan my annual leave: 10 days, plus 2 comp days that expire at the end of June.</p>
            <p class="install-ask" data-i18n="term-ask2">› Use Archify to answer as one page: our API's P99 went from 80 ms to 600 ms while the mean barely moved. Why?</p>
          </div>
        </div>

        <ol class="steps fade-up d1">
          <li class="step">
            <span class="step-num">1</span>
            <div><h3 data-i18n="step1-h">Install in one command</h3>
            <p data-i18n="step1-p">Run the command for your agent, or open the <a href="start.html?agent=cursor&amp;type=architecture">agent-aware quick start</a> for project-scoped installs.</p></div>
          </li>
          <li class="step">
            <span class="step-num">2</span>
            <div><h3 data-i18n="step2-h">Describe it, or ask</h3>
            <p data-i18n="step2-p">Describe the steps, people, parts, or states, or ask the question you have — or ask your agent to read a repository first.</p></div>
          </li>
          <li class="step">
            <span class="step-num">3</span>
            <div><h3 data-i18n="step3-h">Get a map or a page</h3>
            <p data-i18n="step3-p">Ask for a map to explore, or a one-page answer for the conclusion and its reasons. Either way you get one self-contained HTML file to open in any browser and refine in chat.</p></div>
          </li>
        </ol>
      </div>

      <details class="shortcut-drawer fade-up d2">
        <summary class="shortcut-summary">
          <span data-i18n="kbd-label">Inside every artifact</span>
          <span class="shortcut-hint" data-en="12 viewer keyboard shortcuts · click to expand" data-zh="12 个 Viewer 键盘快捷键 · 点击展开">12 viewer keyboard shortcuts · click to expand</span>
        </summary>
        <div class="shortcut-box">
          <div class="shortcut-rows">
