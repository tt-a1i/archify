            <img data-type="erd" src="assets/archify-erd.png" alt="Entity-relationship diagram" loading="lazy" decoding="async" width="2752" height="1544">
            <img data-type="class" src="assets/archify-class.png" alt="Class and interface diagram" loading="lazy" decoding="async" width="2752" height="1544">
