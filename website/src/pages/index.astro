---
import { version, versioned } from '../data/site';
import SupportedDiagrams from '../components/SupportedDiagrams.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import Navigation from '../components/Navigation.astro';
import Brand from '../components/Brand';
import SponsorsStrip from '../components/SponsorsStrip.astro';
import ProductFacts from '../components/ProductFacts.astro';
import { defaultProofLabels } from '../data/default-proof-labels.mjs';
import head from '../data/index-head.html?raw';
import css from '../styles/index.css?raw';
import pageScript from '../scripts/index.js?raw';

const diagramTypes = [
  ['arch', 'Architecture', 'What is it made of?'],
  ['wf', 'Workflow', 'What happens next?'],
  ['seq', 'Sequence', 'Who says what, in what order?'],
  ['flow', 'Data flow', 'Where does it all go?'],
  ['life', 'Lifecycle', 'Where does it stand now?'],
  ['erd', 'Entity-relationship', 'How does the data relate?'],
  ['class', 'Class / interface', 'Which types fulfil which contracts?'],
  ['tree', 'Tree', 'How is it organised?'],
  ['timeline', 'Timeline', 'What happened, and when?'],
  ['waterfall', 'Waterfall', 'Where did the time go?'],
];
const installCommand = 'npx -y skills@latest add https://archify.si --skill archify --agent claude-code --global --copy --yes';
const { lang = 'en' } = Astro.props;
---
<SiteLayout page="index" lang={lang} head={versioned(head)} css={css}>

  <!-- NAV -->
  <Navigation page="index" />
  <main id="main-content">

  <!-- HERO — centered statement; the live artifact window peeks in below the fold line -->
  <section class="hero" data-proof-aperture="first-fold">
    <div class="hero-aura" aria-hidden="true"><div class="hero-spot"></div><div class="hero-horizon"></div></div>
    <div class="hero-copy">
      <a class="hero-eyebrow fade-up" href="https://github.com/tt-a1i/archify/blob/main/CHANGELOG.md" target="_blank" rel="noopener">
        <span class="eyebrow-tag">v{version}</span>
        <span data-i18n="hero-badge">Development Agent Skill · see what's new</span>
        <span class="eyebrow-arrow" aria-hidden="true">→</span>
      </a>
      <h1 data-i18n="hero-h1"><span class="l">Ask in plain words.</span><span class="l">Get answers <em>you can trust.</em></span></h1>
      <p class="hero-sub fade-up d2" data-i18n="hero-sub">A leave plan, a P99 spike, a first HTTPS visit, or a whole codebase — your AI agent answers with an explorable map, or a one-page answer that puts the conclusion first and cites its sources. Either way it is one HTML file, validated before it ships.</p>
      <div class="hero-actions fade-up d3">
        <div class="cmd-chip">
          <span data-en="Paste into your agent to install" data-zh="复制给 Agent 安装">Paste into your agent to install</span>
          <button class="cmd-copy" type="button" data-copy-text="Install Archify for me by reading https://raw.githubusercontent.com/tt-a1i/archify/main/llms.txt" aria-label="Copy installation prompt">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><rect x="4.5" y="4.5" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="1.3"/><path d="M9.5 4.5V3A1.5 1.5 0 0 0 8 1.5H3A1.5 1.5 0 0 0 1.5 3v5A1.5 1.5 0 0 0 3 9.5h1.5" stroke="currentColor" stroke-width="1.3"/></svg>
            <span class="cmd-copy-label" data-i18n="copy">Copy</span>
          </button>
        </div>
        <a class="btn btn-primary" href="start.html">
          <span data-i18n="hero-cta">Get started</span>
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7h10M7 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <button class="btn btn-ghost demo-trigger" id="demo-open" type="button" aria-haspopup="dialog">
          <span class="play-ring" aria-hidden="true"><svg width="8" height="9" viewBox="0 0 9 10" fill="none"><path d="M1 1.2v7.6L8 5z" fill="currentColor"/></svg></span>
          <span data-i18n="demo-watch">Watch the 35s demo</span>
        </button>
      </div>
      <div class="hero-meta fade-up d4">
        <span class="hero-works"><span data-i18n="hero-works">Works with</span>
          <span class="works-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#d97757" d="m4.7144 15.9555 4.7174-2.6471.079-.2307-.079-.1275h-.2307l-.7893-.0486-2.6956-.0729-2.3375-.0971-2.2646-.1214-.5707-.1215-.5343-.7042.0546-.3522.4797-.3218.686.0608 1.5179.1032 2.2767.1578 1.6514.0972 2.4468.255h.3886l.0546-.1579-.1336-.0971-.1032-.0972L6.973 9.8356l-2.55-1.6879-1.3356-.9714-.7225-.4918-.3643-.4614-.1578-1.0078.6557-.7225.8803.0607.2246.0607.8925.686 1.9064 1.4754 2.4893 1.8336.3643.3035.1457-.1032.0182-.0728-.164-.2733-1.3539-2.4467-1.445-2.4893-.6435-1.032-.17-.6194c-.0607-.255-.1032-.4674-.1032-.7285L6.287.1335 6.6997 0l.9957.1336.419.3642.6192 1.4147 1.0018 2.2282 1.5543 3.0296.4553.8985.2429.8318.091.255h.1579v-.1457l.1275-1.706.2368-2.0947.2307-2.6957.0789-.7589.3764-.9107.7468-.4918.5828.2793.4797.686-.0668.4433-.2853 1.8517-.5586 2.9021-.3643 1.9429h.2125l.2429-.2429.9835-1.3053 1.6514-2.0643.7286-.8196.85-.9046.5464-.4311h1.0321l.759 1.1293-.34 1.1657-1.0625 1.3478-.8804 1.1414-1.2628 1.7-.7893 1.36.0729.1093.1882-.0183 2.8535-.607 1.5421-.2794 1.8396-.3157.8318.3886.091.3946-.3278.8075-1.967.4857-2.3072.4614-3.4364.8136-.0425.0304.0486.0607 1.5482.1457.6618.0364h1.621l3.0175.2247.7892.522.4736.6376-.079.4857-1.2142.6193-1.6393-.3886-3.825-.9107-1.3113-.3279h-.1822v.1093l1.0929 1.0686 2.0035 1.8092 2.5075 2.3314.1275.5768-.3218.4554-.34-.0486-2.2039-1.6575-.85-.7468-1.9246-1.621h-.1275v.17l.4432.6496 2.3436 3.5214.1214 1.0807-.17.3521-.6071.2125-.6679-.1214-1.3721-1.9246L14.38 17.959l-1.1414-1.9428-.1397.079-.674 7.2552-.3156.3703-.7286.2793-.6071-.4614-.3218-.7468.3218-1.4753.3886-1.9246.3157-1.53.2853-1.9004.17-.6314-.0121-.0425-.1397.0182-1.4328 1.9672-2.1796 2.9446-1.7243 1.8456-.4128.164-.7164-.3704.0667-.6618.4008-.5889 2.386-3.0357 1.4389-1.882.929-1.0868-.0062-.1579h-.0546l-6.3385 4.1164-1.1293.1457-.4857-.4554.0608-.7467.2307-.2429 1.9064-1.3114Z"/></svg>Claude Code</span>
          <span class="works-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M22.2819 9.8211a5.9847 5.9847 0 0 0-.5157-4.9108 6.0462 6.0462 0 0 0-6.5098-2.9A6.0651 6.0651 0 0 0 4.9807 4.1818a5.9847 5.9847 0 0 0-3.9977 2.9 6.0462 6.0462 0 0 0 .7427 7.0966 5.98 5.98 0 0 0 .511 4.9107 6.051 6.051 0 0 0 6.5146 2.9001A5.9847 5.9847 0 0 0 13.2599 24a6.0557 6.0557 0 0 0 5.7718-4.2058 5.9894 5.9894 0 0 0 3.9977-2.9001 6.0557 6.0557 0 0 0-.7475-7.0729zm-9.022 12.6081a4.4755 4.4755 0 0 1-2.8764-1.0408l.1419-.0804 4.7783-2.7582a.7948.7948 0 0 0 .3927-.6813v-6.7369l2.02 1.1686a.071.071 0 0 1 .038.052v5.5826a4.504 4.504 0 0 1-4.4945 4.4944zm-9.6607-4.1254a4.4708 4.4708 0 0 1-.5346-3.0137l.142.0852 4.783 2.7582a.7712.7712 0 0 0 .7806 0l5.8428-3.3685v2.3324a.0804.0804 0 0 1-.0332.0615L9.74 19.9502a4.4992 4.4992 0 0 1-6.1408-1.6464zM2.3408 7.8956a4.485 4.485 0 0 1 2.3655-1.9728V11.6a.7664.7664 0 0 0 .3879.6765l5.8144 3.3543-2.0201 1.1685a.0757.0757 0 0 1-.071 0l-4.8303-2.7865A4.504 4.504 0 0 1 2.3408 7.872zm16.5963 3.8558L13.1038 8.364 15.1192 7.2a.0757.0757 0 0 1 .071 0l4.8303 2.7913a4.4944 4.4944 0 0 1-.6765 8.1042v-5.6772a.79.79 0 0 0-.407-.667zm2.0107-3.0231l-.142-.0852-4.7735-2.7818a.7759.7759 0 0 0-.7854 0L9.409 9.2297V6.8974a.0662.0662 0 0 1 .0284-.0615l4.8303-2.7866a4.4992 4.4992 0 0 1 6.6802 4.66zM8.3065 12.863l-2.02-1.1638a.0804.0804 0 0 1-.038-.0567V6.0742a4.4992 4.4992 0 0 1 7.3757-3.4537l-.142.0805L8.704 5.459a.7948.7948 0 0 0-.3927.6813zm1.0976-2.3654l2.602-1.4998 2.6069 1.4998v2.9994l-2.5974 1.4997-2.6067-1.4997Z"/></svg>Codex</span>
          <span class="works-item"><svg viewBox="0 0 800 800" aria-hidden="true"><path fill="#F09082" d="M165.29 165.29H517.36V400H400V282.65H165.29Z"/><path fill="#4D9ABF" d="M165.29 282.65H282.65V400H400V517.36H282.65V634.72H165.29Z"/><path fill="#F1BE58" d="M517.36 400H634.72V634.72H517.36Z"/></svg>Pi</span>
          <span class="works-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M22 24H2V0h20zM17 4.8H7v14.4h10z"/></svg>OpenCode</span>
          <span class="works-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M23.922 16.997C23.061 18.492 18.063 22.02 12 22.02 5.937 22.02.939 18.492.078 16.997A.641.641 0 0 1 0 16.741v-2.869a.883.883 0 0 1 .053-.22c.372-.935 1.347-2.292 2.605-2.656.167-.429.414-1.055.644-1.517a10.098 10.098 0 0 1-.052-1.086c0-1.331.282-2.499 1.132-3.368.397-.406.89-.717 1.474-.952C7.255 2.937 9.248 1.98 11.978 1.98c2.731 0 4.767.957 6.166 2.093.584.235 1.077.546 1.474.952.85.869 1.132 2.037 1.132 3.368 0 .368-.014.733-.052 1.086.23.462.477 1.088.644 1.517 1.258.364 2.233 1.721 2.605 2.656a.841.841 0 0 1 .053.22v2.869a.641.641 0 0 1-.078.256Zm-11.75-5.992h-.344a4.359 4.359 0 0 1-.355.508c-.77.947-1.918 1.492-3.508 1.492-1.725 0-2.989-.359-3.782-1.259a2.137 2.137 0 0 1-.085-.104L4 11.746v6.585c1.435.779 4.514 2.179 8 2.179 3.486 0 6.565-1.4 8-2.179v-6.585l-.098-.104s-.033.045-.085.104c-.793.9-2.057 1.259-3.782 1.259-1.59 0-2.738-.545-3.508-1.492a4.359 4.359 0 0 1-.355-.508Zm2.328 3.25c.549 0 1 .451 1 1v2c0 .549-.451 1-1 1-.549 0-1-.451-1-1v-2c0-.549.451-1-1-1Zm-5 0c.549 0 1 .451 1 1v2c0 .549-.451 1-1 1-.549 0-1-.451-1-1v-2c0-.549.451-1-1-1Zm3.313-6.185c.136 1.057.403 1.913.878 2.497.442.544 1.134.938 2.344.938 1.573 0 2.292-.337 2.657-.751.384-.435.558-1.15.558-2.361 0-1.14-.243-1.847-.705-2.319-.477-.488-1.319-.862-2.824-1.025-1.487-.161-2.192.138-2.533.529-.269.307-.437.808-.438 1.578v.021c0 .265.021.562.063.893Zm-1.626 0c.042-.331.063-.628.063-.894v-.02c-.001-.77-.169-1.271-.438-1.578-.341-.391-1.046-.69-2.533-.529-1.505.163-2.347.537-2.824 1.025-.462.472-.705 1.179-.705 2.319 0 1.211.175 1.926.558 2.361.365.414 1.084.751 2.657.751 1.21 0 1.902-.394 2.344-.938.475-.584.742-1.44.878-2.497Z"/></svg>Copilot</span>
        </span>
        <a class="hero-stars" href="https://github.com/tt-a1i/archify" target="_blank" rel="noopener">
          <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 .2a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.72 1.22 1.88.87 2.34.66.07-.52.28-.87.5-1.07-1.78-.2-3.65-.89-3.65-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.66 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 8 .2Z"/></svg>
          <span class="stars-count" data-gh-stars hidden></span>
          <span data-i18n="hero-stars">stars on GitHub</span>
        </a>
      </div>
    </div>
  </section>

  <!-- LIVE STAGE — one real artifact, pinned; scrolling drives its semantic camera -->
  <section class="stage" id="tour" aria-labelledby="tour-title">
    <h2 class="sr-only" id="tour-title" data-i18n="tour-title">Live artifact tour</h2>
    <div class="stage-pin">
      <div class="stage-window" id="hero-proof-stage" data-proof-playback="first-fold-once" data-mode="map">
        <div class="window-bar">
          <span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <div class="mode-switch" role="group" aria-label={lang === 'zh' ? '选择 Archify 生成什么' : 'Choose what Archify makes'}>
            <span class="mode-thumb" aria-hidden="true"></span>
            <button type="button" data-mode="map" aria-pressed="true"><span data-i18n="mode-map">Map</span></button>
            <button type="button" data-mode="page" aria-pressed="false"><span data-i18n="mode-page">Page</span><i class="mode-new" data-i18n="mode-new">New</i></button>
          </div>
          <div class="proof-rail" id="proof-tabs" role="tablist" aria-label="Choose a live Archify proof">
            <button class="spec-card" id="proof-tab-signal" type="button" role="tab" aria-controls="hero-proof-panel" aria-selected="true" tabindex="0" data-proof="signal" data-mode="map">
              <span class="spec-idx">01</span><span class="spec-name">Agent Tool Call</span>
            </button>
            <button class="spec-card" id="proof-tab-blueprint" type="button" role="tab" aria-controls="hero-proof-panel" aria-selected="false" tabindex="-1" data-proof="blueprint" data-mode="map">
              <span class="spec-idx">02</span><span class="spec-name">Production Deployment</span>
            </button>
            <button class="spec-card" id="proof-tab-classic" type="button" role="tab" aria-controls="hero-proof-panel" aria-selected="false" tabindex="-1" data-proof="classic" data-mode="map">
              <span class="spec-idx">03</span><span class="spec-name">Cache Miss</span>
            </button>
            <button class="spec-card" id="proof-tab-leave" type="button" role="tab" aria-controls="hero-proof-panel" aria-selected="false" tabindex="-1" data-proof="leave" data-mode="map">
              <span class="spec-idx">04</span><span class="spec-name">Annual Leave</span>
            </button>
            <button class="spec-card" id="proof-tab-tls" type="button" role="tab" aria-controls="hero-proof-panel" aria-selected="false" tabindex="-1" data-proof="tls" data-mode="page" hidden>
              <span class="spec-idx">01</span><span class="spec-name">First HTTPS Visit</span>
            </button>
            <button class="spec-card" id="proof-tab-repo" type="button" role="tab" aria-controls="hero-proof-panel" aria-selected="false" tabindex="-1" data-proof="repo" data-mode="page" hidden>
              <span class="spec-idx">02</span><span class="spec-name">Read a Repo</span>
            </button>
          </div>
          <div class="window-address" aria-hidden="true">
            <svg width="11" height="11" viewBox="0 0 12 12" fill="none"><rect x="2" y="5.5" width="8" height="5.5" rx="1.2" stroke="currentColor" stroke-width="1.2"/><path d="M4 5.5V4a2 2 0 1 1 4 0v1.5" stroke="currentColor" stroke-width="1.2"/></svg>
            <span id="address-file">agent-tool-call.workflow.html</span><b id="address-hash"></b>
          </div>
          <a class="proof-open" id="proof-open" href="gallery/artifacts/agent-tool-call.workflow.html?present=1#focus=planner&amp;reach=downstream" target="_blank" rel="noopener" aria-label={lang === 'zh' ? '在新标签页打开交互图表' : 'Open the interactive diagram in a new tab'}>
            <span data-i18n="proof-open">Open artifact</span><span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="hero-frame" id="hero-proof-panel" role="tabpanel" aria-labelledby="proof-tab-signal">
          <iframe id="hero-proof-frame" data-proof="signal" src="gallery/artifacts/agent-tool-call.workflow.html?embed=1&amp;theme=dark#focus=planner&amp;reach=downstream" title="Agent Tool Call live Archify proof" loading="eager" sandbox="allow-scripts allow-same-origin"></iframe>
          <!-- A real explainer page, driven by the scroll; the reader opens it in a tab to use it. -->
          <iframe id="hero-page-frame" class="page-frame" title="One-page answer live Archify proof" tabindex="-1" sandbox="allow-scripts allow-same-origin"></iframe>
        </div>
        <div class="beat-card" aria-live="polite">
          <div class="beat-rail" role="group" aria-label="Camera beats" data-mode="map">
            <button class="beat-tick" type="button" data-beat="0" aria-pressed="true"><span data-i18n="beat-0-k">Map</span></button>
            <button class="beat-tick" type="button" data-beat="1" aria-pressed="false"><span data-i18n="beat-1-k">Focus</span></button>
            <button class="beat-tick" type="button" data-beat="2" aria-pressed="false"><span data-i18n="beat-2-k">Upstream</span></button>
            <button class="beat-tick" type="button" data-beat="3" aria-pressed="false"><span data-i18n="beat-3-k">Lens</span></button>
          </div>
          <div class="beat-rail" role="group" aria-label="Page beats" data-mode="page" hidden>
            <button class="beat-tick" type="button" data-beat="0" aria-pressed="false"><span data-i18n="pbeat-0-k">Answer</span></button>
            <button class="beat-tick" type="button" data-beat="1" aria-pressed="false"><span data-i18n="pbeat-1-k">Walk</span></button>
            <button class="beat-tick" type="button" data-beat="2" aria-pressed="false"><span data-i18n="pbeat-2-k">Check</span></button>
            <button class="beat-tick" type="button" data-beat="3" aria-pressed="false"><span data-i18n="pbeat-3-k">Style</span></button>
            <button class="beat-tick" type="button" data-beat="4" aria-pressed="false"><span data-i18n="pbeat-4-k">Ask</span></button>
          </div>
          <p class="beat-meta"><span class="proof-live" data-i18n="proof-live">Live proof</span><span id="proof-meta" data-en={defaultProofLabels.meta.en} data-zh={defaultProofLabels.meta.zh}>{defaultProofLabels.meta.en}</span></p>
          <h3 class="beat-title" id="beat-title" data-i18n="beat-0-t">The whole system, in one readable frame.</h3>
          <p class="beat-body" id="beat-body" data-i18n="beat-0-b">This is the real generated artifact, not a screenshot. Lanes, boundaries, and every authored edge — scroll to move its camera.</p>
          <strong class="sr-only" id="proof-title" data-en={defaultProofLabels.title.en} data-zh={defaultProofLabels.title.zh}>{defaultProofLabels.title.en}</strong>
        </div>
      </div>
    </div>
  </section>

  <!-- PROOF STRIP — receipts, not adjectives -->
  <section class="receipts" aria-label="Archify at a glance">
    <div class="container receipts-row">
      <div class="receipt fade-up"><b>2</b><span data-i18n="stat-modes">Ways to answer: map or page</span></div>
      <div class="receipt fade-up d1"><b>10</b><span data-i18n="stat-types">Diagram types</span></div>
      <div class="receipt fade-up d2"><b>4</b><span data-i18n="stat-styles">Page styles, light and dark</span></div>
      <div class="receipt fade-up d3"><b>9/9</b><span data-i18n="stat-checks">Validation checks per diagram</span></div>
      <div class="receipt fade-up d4"><b>0</b><span data-i18n="stat-deps">Runtime dependencies</span></div>
    </div>
  </section>

  <!-- COMPACT SPONSORS STRIP — links to full matrix on /community#sponsors -->
  <SponsorsStrip />

  <!-- ANSWERS — one-page explainers: the conclusion first, then panels that explain and can be checked -->
  <section id="answers">
    <div class="container">
      <header class="section-head section-head-row fade-up">
        <div>
          <p class="section-label"><span>01</span><span data-i18n="label-answers">One-page answers</span></p>
          <h2 class="section-heading" data-i18n="answers-h2">Ask a question. <em>Get a page you can check.</em></h2>
        </div>
        <p class="section-body" data-i18n="answers-body">Conclusion first, then one panel per question: tables, steps, charts and checked diagrams, with numbered sources and code pinned to a commit.</p>
      </header>
      <!-- Each plate holds the whole page; hovering scrolls through it top to bottom. -->
      <div class="page-grid">
        <a class="page-card fade-up" href="cases/explainer/p99-tail-latency.html" target="_blank" rel="noopener">
          <span class="page-plate"><img src="assets/explainer/p99-tail-latency.webp" alt="接口 P99 从 80 ms 涨到 600 ms" loading="lazy" decoding="async" width="640" height="882"></span>
          <span class="life-meta"><span class="life-lang">中文</span><span class="life-kind" data-i18n="style-clean">Clean · light</span><span class="life-open" aria-hidden="true">↗</span></span>
          <span class="life-q" data-i18n="answers-p99-q">Why did P99 jump while the mean stayed flat?</span>
        </a>
        <a class="page-card fade-up d1" href="cases/explainer/tls-first-visit.html" target="_blank" rel="noopener">
