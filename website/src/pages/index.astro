        <div class="type-preview fade-up d1" id="type-preview">
          <div class="type-plate">
            <img class="is-active" data-type="arch" src="assets/archify-architecture.png" alt="Architecture diagram" loading="lazy" decoding="async" width="2752" height="1544">
