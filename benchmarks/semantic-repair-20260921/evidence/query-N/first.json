  "cards": [
    {
      "dot": "cyan",
      "title": "Fresh versus fetching",
      "items": [
        "fetchQuery resolves cached data when isStaleByTime is false.",
        "A stale Query fetches; an already active retryer normally continues and returns its current promise."
      ]
    },
    {
      "dot": "amber",
      "title": "Failure and cancellation",
      "items": [
        "Retryer retries according to retry and retryDelay, pausing when it cannot continue.",
        "Cancellation aborts the controller; a reverting cancellation can restore the pre-fetch state."
      ]
    },
    {
      "dot": "emerald",
      "title": "State fan-out",
      "items": [
        "Successful data or an error is dispatched into Query state.",
        "Each dispatch batches observer updates and a QueryCache updated event."
      ]
    }
