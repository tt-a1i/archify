  "cards": [
    {
      "dot": "cyan",
      "title": "Two work states",
      "items": [
        "Waiting work remains in the priority queue until admission dequeues its run closure",
        "Active work increments pending before the caller task executes and releases it in a microtask afterward"
      ]
    },
    {
      "dot": "amber",
      "title": "Abort and timeout boundary",
      "items": [
        "A queued abort removes only that waiting closure and rejects its returned promise",
        "After dequeue, timeout begins and an AbortSignal races the running operation; either path settles as rejection"
      ]
    },
    {
      "dot": "violet",
      "title": "Admission and continuation",
      "items": [
        "PQueue starts work only when it is not paused and both interval and concurrency checks allow it",
        "Settlement triggers the next admission attempt, so freed capacity can start more waiting work"
      ]
    }
  ]
