  "cards": [
    {"dot": "cyan", "title": "Request and fetch boundary", "items": ["The constructor normalizes options, builds a Request, and combines the user signal with Ky's AbortController.", "Ky calls options.fetch when supplied; otherwise it binds globalThis.fetch. A timeout aborts the managed controller."]},
    {"dot": "amber", "title": "Retry is a second control path", "items": ["A normal retry requires remaining limit, a retriable method, and a matching timeout, HTTP, or network rule unless shouldRetry overrides it.", "beforeRetry may replace the Request, return a Response, or return stop; an eligible retry then re-enters fetch."]},
    {"dot": "violet", "title": "Terminal behavior", "items": ["beforeRequest can return a Response before any fetch. afterResponse can replace a response or request a forced retry.", "Thrown Errors pass through beforeError hooks before rejection; a stopped retry resolves without a Response."]}
  ]
