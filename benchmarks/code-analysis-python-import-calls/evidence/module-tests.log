        {
          "path": "app/a.py",
          "loc": 10,
          "role": "source",
          "sourceText": "\"\"\"Settings shared by the request handlers.\"\"\"\nfrom app.b import Handler\n\nDEFAULT_TIMEOUT = 30\n\n\nclass Config:\n    def __init__(self, timeout=DEFAULT_TIMEOUT):\n        self.timeout = timeout\n        self.handler = Handler(self)\n"
        },
        {
          "path": "app/b.py",
          "loc": 10,
          "role": "source",
          "sourceText": "\"\"\"Request handler that reads its limits from the config.\"\"\"\nfrom app.a import DEFAULT_TIMEOUT\n\n\nclass Handler:\n    def __init__(self, config):\n        self.config = config\n\n    def limit(self):\n        return self.config.timeout or DEFAULT_TIMEOUT\n"
        },
        {
          "path": "app/engine.py",
          "loc": 42,
          "role": "source",
          "sourceText": "\"\"\"Routes an incoming message to a handler.\"\"\"\n\n\ndef route(message, user, flags):\n    if not message:\n        return None\n    kind = message.get(\"kind\")\n    if kind == \"text\":\n        if user.get(\"muted\"):\n            return \"drop\"\n        if flags.get(\"translate\") and message.get(\"lang\") != user.get(\"lang\"):\n            return \"translate\"\n        return \"text\"\n    elif kind == \"image\":\n        if message.get(\"size\", 0) > 10_000_000:\n            return \"too-large\"\n        for tag in message.get(\"tags\", []):\n            if tag == \"nsfw\" and not user.get(\"adult\"):\n                return \"blocked\"\n        return \"image\"\n    elif kind == \"command\":\n        name = message.get(\"name\")\n        if name == \"help\":\n            return \"help\"\n        elif name == \"stop\" or name == \"quit\":\n            return \"stop\"\n        elif name == \"retry\":\n            while flags.get(\"busy\"):\n                flags[\"busy\"] = False\n            return \"retry\"\n        return \"unknown-command\"\n    elif kind == \"event\":\n        try:\n            code = int(message.get(\"code\"))\n        except (TypeError, ValueError):\n            return \"bad-event\"\n        return \"event\" if code > 0 else \"noop\"\n    return \"unsupported\"\n\n\ndef describe(result):\n    return result or \"none\"\n"
        },
        {
          "path": "domain/__init__.py",
          "loc": 0,
          "role": "source",
          "sourceText": ""
        },
        {
          "path": "domain/model.py",
          "loc": 9,
          "role": "source",
          "sourceText": "\"\"\"Order model.\"\"\"\n\n\nclass Order:\n    def __init__(self, items):\n        self.items = list(items)\n\n    def total(self):\n        return sum(item[\"price\"] for item in self.items)\n"
        },
        {
          "path": "domain/order.py",
          "loc": 8,
          "role": "source",
          "sourceText": "\"\"\"Order checkout.\"\"\"\nfrom domain.model import Order\nfrom ui.view import format_price\n\n\ndef checkout(items):\n    order = Order(items)\n    return format_price(order.total())\n"
        },
        {
          "path": "ui/__init__.py",
          "loc": 0,
          "role": "source",
          "sourceText": ""
        },
        {
          "path": "ui/view.py",
          "loc": 10,
          "role": "source",
          "sourceText": "\"\"\"Formatting helpers for the order screen.\"\"\"\nfrom domain.model import Order\n\n\ndef format_price(value):\n    return f\"${value:,.2f}\"\n\n\ndef render(items):\n    return format_price(Order(items).total())\n"
        }
      ],
