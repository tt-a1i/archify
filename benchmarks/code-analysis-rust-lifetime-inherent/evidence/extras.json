{
  "commands": [
    {
      "label": "legacy-v1",
      "command": [
        "node",
        "$WORKSPACE/work/archify-rust-lifetime/archify/bin/archify.mjs",
        "code-analysis",
        "task",
        "$WORKSPACE/work/combined-rust-source/regex",
        "--root",
        "$WORKSPACE/work/samples/regex",
        "--entry",
        "regex-syntax/src/lib.rs",
        "--question",
        "What does this original saved Rust source model establish without rebinding?",
        "--format",
        "json",
        "--out",
        "$WORKSPACE/work/rust-lifetime-extras-source/v1.json",
        "--json"
      ],
      "exit": 0
    },
    {
      "label": "legacy-v2",
      "command": [
        "node",
        "$WORKSPACE/work/archify-rust-lifetime/archify/bin/archify.mjs",
        "code-analysis",
        "task",
        "$WORKSPACE/work/rust-specialized-accepted-baseline/default",
        "--root",
        "$WORKSPACE/work/samples/serde-json",
        "--entry",
        "src/value/index.rs",
        "--question",
        "What does this original saved Rust source model establish without rebinding?",
        "--format",
        "json",
        "--out",
        "$WORKSPACE/work/rust-lifetime-extras-source/v2.json",
        "--json"
      ],
      "exit": 0
    },
    {
      "label": "legacy-v3",
      "command": [
        "node",
        "$WORKSPACE/work/archify-rust-lifetime/archify/bin/archify.mjs",
        "code-analysis",
        "task",
        "$WORKSPACE/work/rust-lifetime-baseline-replay/capture",
        "--root",
        "$WORKSPACE/work/samples/regex",
        "--entry",
        "regex-syntax/src/hir/translate.rs",
        "--question",
        "What does this original saved Rust source model establish without rebinding?",
        "--format",
        "json",
        "--out",
        "$WORKSPACE/work/rust-lifetime-extras-source/v3.json",
        "--json",
        "--function",
        "hir::translate::Translator::translate"
      ],
      "exit": 0
    },
    {
      "label": "missing-sdk",
      "command": [
        "node",
        "$WORKSPACE/work/archify-rust-lifetime/archify/bin/archify.mjs",
        "code-analysis",
        "check",
        "$WORKSPACE/work/samples/regex",
        "--language",
        "rust",
        "--fail-on",
        "never",
        "--out",
        "$WORKSPACE/work/rust-lifetime-extras-source/missing-capture",
        "--json"
      ],
      "environment": {
        "ARCHIFY_RUSTC": "$ABSENT_TOOL",
        "ARCHIFY_CARGO": "$ABSENT_TOOL"
      },
      "exit": 2
    }
  ],
  "historical": [
    {
      "model": "rust-source-direct-v1",
      "coverage": "available",
      "bindingCoverage": "rust-explicit-source-functions-under-declared-cargo-cfg-profile",
      "included": 13,
      "omitted": 0
    },
    {
      "model": "rust-source-direct-v2",
      "coverage": "available",
      "bindingCoverage": "rust-explicit-functions-and-monomorphic-inherent-source-candidates-under-declared-cargo-cfg-profile",
      "included": 30,
      "omitted": 0
    },
    {
      "model": "rust-source-direct-v3",
      "coverage": "available",
      "bindingCoverage": "rust-explicit-functions-monomorphic-and-unique-concrete-specialization-source-candidates-under-declared-cargo-cfg-profile",
      "included": 2,
      "omitted": 0
    }
  ],
  "missingSdk": {
    "exit": 2,
    "diagnostic": "extract/rust-unavailable",
    "normalToolchainRequirement": "Installed Cargo/rustc1.71+ and locked helper dependencies; optional RA is not a product requirement."
  },
  "projectExecuted": false
}
