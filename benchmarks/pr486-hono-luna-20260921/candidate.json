  "cards": [
    {
      "dot": "cyan",
      "title": "Normal request",
      "items": [
        "fetch delegates to dispatch, which computes the path and creates Context",
        "The router supplies an ordered result consumed by the middleware composer"
      ]
    },
    {
      "dot": "amber",
      "title": "Terminal paths",
      "items": [
        "A handler response finalizes Context; an unfinalized chain reaches notFound",
        "Thrown Error values are routed through the configured error handler"
      ]
    },
    {
      "dot": "violet",
      "title": "HEAD behavior",
      "items": [
        "HEAD recursively dispatches as GET and wraps the result in a bodyless Response"
      ]
    }
