    { "id": "windows", "lane": "windows", "col": 0, "type": "backend", "label": "Windows paths", "sublabel": "Node 22 + 24" },
    { "id": "checks", "lane": "validation", "col": 1, "type": "security", "label": "Regressions", "sublabel": "unit, WebM, browser" },
    { "id": "version", "lane": "identity", "col": 2, "type": "security", "label": "Version match", "sublabel": "tag = package.json", "yOffset": -60 },
    { "id": "channel", "lane": "identity", "col": 2, "type": "backend", "label": "Channel", "sublabel": "skill-release.json", "yOffset": 60 },
    { "id": "tag", "lane": "identity", "col": 3, "type": "security", "label": "Stable tag", "sublabel": "annotated Git tag", "yOffset": -60 },
    { "id": "manifest", "lane": "identity", "col": 3, "type": "security", "label": "Notifier guard", "sublabel": "stable.json < tag", "yOffset": 60 },
    { "id": "build", "lane": "artifact", "col": 4, "type": "backend", "label": "Build archive", "sublabel": "build-zip.sh", "yOffset": -60 },
    { "id": "smoke", "lane": "artifact", "col": 4, "type": "security", "label": "Package smoke", "sublabel": "package-smoke.mjs", "yOffset": 60 },
    { "id": "bytes", "lane": "artifact", "col": 5, "type": "security", "label": "Byte identity", "sublabel": "built = committed", "yOffset": -60 },
    { "id": "publish", "lane": "artifact", "col": 5, "type": "external", "label": "GitHub Release", "sublabel": "archify.zip asset", "yOffset": 60 }
