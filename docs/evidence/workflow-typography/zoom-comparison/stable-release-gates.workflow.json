  "cards": [
    { "dot": "cyan", "title": "Stable-channel scope", "items": ["Triggered by a v* tag. Windows portability must pass before the Ubuntu job starts.", "The regression gate includes npm test, test:webm and test:browser; runtime provisioning is summarized."] },
    { "dot": "amber", "title": "Publication contract", "items": ["This path chooses stable publication: annotated tag, older stable.json, exact archive smoke and byte identity.", "A failed gate prevents later normal steps. The development branch and post-publication follow-up reminder are outside the selected scope."] }
