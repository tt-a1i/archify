+ const file=artifact('inline-command-wrap',renderExplainer(doc,{sourceText:JSON.stringify(doc),preparedSources:{sources:{example:{title:'Example'}}}}));
+ const browser=new ChromeVisualBrowser(chrome);try {
+  for(const state of [{width:390},{width:1440},{width:390,javascript:false},{width:390,media:'print'}]){
+   await browser.resetPage();await inspectPublicHtml(browser,{artifactPath:file,height:900,theme:'light',keyboard:false,...state});
+   const result=await pageValue(browser,`(()=>{
+    const code=document.querySelector('#restore-table code'),range=document.createRange();range.selectNodeContents(code);
+    const selection=getSelection();selection.removeAllRanges();selection.addRange(range);const selected=selection.toString();selection.removeAllRanges();
+    const walker=document.createTreeWalker(code,NodeFilter.SHOW_TEXT),chars=[];let node;
+    while(node=walker.nextNode())for(let i=0;i<node.length;i++){const r=document.createRange();r.setStart(node,i);r.setEnd(node,i+1);chars.push(r.getBoundingClientRect().top);}
+    const words=[...code.textContent.matchAll(/\\S+/g)].map(m=>({text:m[0],lines:new Set(chars.slice(m.index,m.index+m[0].length).map(y=>Math.round(y))).size}));
+    const path=document.querySelector('#long-path'),table=document.querySelector('#restore-table .table-scroll');
+    return {text:code.textContent,selected,words,pathWidth:path.clientWidth,pathScroll:path.scrollWidth,pathText:path.querySelector('code').textContent,tableWidth:table.clientWidth,tableScroll:table.scrollWidth,literal:document.querySelector('#literal code').textContent,images:document.querySelectorAll('#literal img').length,fenced:document.querySelector('#fenced pre code').textContent};
+   })()`);
+   assert.deepEqual(result.words.filter(w=>w.lines!==1),[],JSON.stringify({state,result}));
+   assert.equal(result.text,command);assert.equal(result.selected,command);
+   assert.equal(result.pathText,longPath);assert.ok(result.pathScroll<=result.pathWidth+1,JSON.stringify({state,result}));
+   assert.ok(result.tableScroll<=result.tableWidth+1,JSON.stringify({state,result}));
+   assert.equal(result.literal,'<img src=x onerror=alert(1)>');assert.equal(result.images,0);assert.equal(result.fenced,command+'\n');
+  }
+ }finally{await browser.close();}
+});
