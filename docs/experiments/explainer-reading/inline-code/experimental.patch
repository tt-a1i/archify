+  {id:'restore-table',type:'comparison',columns:['命令与结果'],label:'目的',rows:[{id:'restore-both',label:'两处都恢复',cells:[{text:'`'+command+'`。HEAD → 暂存区和工作区。'}]}]},
+  {id:'long-path',type:'prose',text:'路径：`'+longPath+'`。'},
+  {id:'literal',type:'prose',text:'字面内容：`<img src=x onerror=alert(1)>`。'},
+  {id:'fenced',type:'snippet',text:command+'\n',language:'sh'}
