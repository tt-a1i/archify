      "pos": [620, 230],
      "size": [200, 140],
      "attributes": [
        { "name": "id", "role": "primary" },
        { "name": "order_id", "role": "foreign", "references": "orders.id" },
        { "name": "product_id", "role": "foreign", "references": "products.id" },
        { "name": "quantity" }
      ]
    },
    {
      "id": "payments",
      "label": "payments",
      "kind": "transactional",
      "pos": [920, 120],
      "size": [190, 104],
      "attributes": [
        { "name": "id", "role": "primary" },
        { "name": "order_id", "role": "foreign", "references": "orders.id" },
        { "name": "amount_cents" }
      ]
    },
    {
      "id": "audit_events",
      "label": "audit_events",
      "kind": "event",
      "pos": [620, 30],
      "size": [200, 104],
      "attributes": [
        { "name": "id", "role": "primary" },
        { "name": "order_id", "role": "foreign", "references": "orders.id" },
        { "name": "kind" }
      ]
    },
    {
      "id": "payment_gateway",
      "label": "payment_gateway",
      "kind": "external",
      "pos": [920, 360],
      "size": [190, 86],
      "attributes": [
        { "name": "gateway_id" },
        { "name": "name" }
      ]
    }
  ],
  "relationships": [
    {
      "id": "users_orders",
      "from": "users",
      "to": "orders",
      "label": "places",
      "cardinality": { "from": "1", "to": "0..N" }
    },
    {
      "id": "orders_items",
      "from": "orders",
      "to": "order_items",
      "label": "has lines",
      "cardinality": { "from": "1", "to": "0..N" }
    },
    {
      "id": "products_items",
      "from": "products",
      "to": "order_items",
      "label": "listed in",
      "cardinality": { "from": "1", "to": "0..N" }
