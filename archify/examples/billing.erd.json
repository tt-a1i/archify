        { "name": "total_cents" }
      ]
    },
    {
      "id": "products",
      "label": "products",
      "kind": "reference",
      "pos": [320, 360],
      "size": [190, 104],
      "attributes": [
        { "name": "id", "role": "primary" },
        { "name": "sku" },
        { "name": "unit_price_cents" }
      ]
    },
    {
      "id": "order_items",
      "label": "order_items",
