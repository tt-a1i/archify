    {
      "id": "orders_payments",
      "from": "orders",
      "to": "payments",
      "label": "paid by",
      "enforced_by": "payments.order_id",
      "cardinality": { "from": "1", "to": "0..N" }
    },
    {
      "id": "payments_gateway",
