  "cards": [
    {
      "dot": "cyan",
      "title": "Turn pipeline",
      "items": [
        "Wake word matched by pinyin; follow-up window skips it",
        "LLM text split into sentences, each synthesized and played while the next streams",
        "Stop words or a keypress interrupt playback (barge-in)"
      ]
    },
    {
      "dot": "rose",
      "title": "Voice lock",
      "items": [
        "Unknown speakers with a usable embedding cannot wake or continue a turn",
        "The assistant's own voice is filtered out before ASR"
      ]
    },
    {
      "dot": "violet",
      "title": "LLM routing",
      "items": [
        "chat: no tools; lookup: run pipeline first; ask: model picks a registry tool",
        "Facts are extracted from turns asynchronously into memory"
      ]
    },
    {
      "dot": "amber",
      "title": "Side channels",
      "items": [
        "UI input bar sends typed questions back through hub.on_ask",
        "Flashes are held while a turn is active"
      ]
    }
  ]
