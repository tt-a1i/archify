  "cards": [
    {
      "dot": "cyan",
      "title": "Admission and waiting",
      "items": [
        "Missing tenant or payload returns 400",
        "Accepted jobs enter an in-memory FIFO and return 202 queued"
      ]
    },
    {
      "dot": "emerald",
      "title": "Bounded dispatch",
      "items": [
        "pump() dispatches only while active < concurrency",
        "finally decrements active and pumps the next waiting job"
      ]
    },
    {
      "dot": "violet",
      "title": "Configured boundaries",
      "items": [
        "Every attempt authorizes before the billing provider call",
        "Successful results are saved to the configured result-store identifier",
        "The fixture implements these integrations as local functions; no network protocol is declared"
      ]
    },
    {
      "dot": "rose",
      "title": "Failure semantics",
      "items": [
        "maxAttempts = 2 creates one retry after the first failure",
        "The second failure moves to dead letter",
        "deadLetterAfter = 3 is stored as an output marker; it does not create a third attempt"
      ]
    }
  ]
