  "boundaries": [
    {
      "kind": "region",
      "label": "Gateway queue runtime",
      "wraps": [
        "gateway",
        "queue",
        "worker"
      ],
      "pad": 32
    },
    {
      "kind": "security-group",
      "label": "Configured service boundaries",
      "wraps": [
        "auth",
        "billing",
        "result"
      ],
      "pad": 28
    }
  ],
  "connections": [
    {
      "id": "submit",
      "from": "tenant",
      "to": "gateway",
      "label": "submitJob(request)",
      "variant": "emphasis"
    },
    {
      "id": "enqueue",
      "from": "gateway",
      "to": "queue",
      "label": "enqueue · 202 jobId",
      "variant": "emphasis"
    },
    {
      "id": "dispatch",
      "from": "queue",
      "to": "worker",
      "label": "dispatch when active < 3"
    },
    {
      "id": "authorize",
      "from": "worker",
      "to": "auth",
      "label": "authorizeTenant",
      "variant": "security",
      "fromSide": "top",
      "toSide": "bottom"
    },
    {
      "id": "token",
      "from": "auth",
      "to": "worker",
      "label": "tenant token",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "bill",
      "from": "worker",
      "to": "billing",
      "label": "callProvider(payload, token)",
      "variant": "emphasis",
      "fromSide": "top",
      "toSide": "bottom"
    },
    {
      "id": "save",
      "from": "worker",
      "to": "result",
      "label": "saveResult(job.id, result)"
    },
    {
      "id": "retry",
      "from": "worker",
      "to": "worker",
      "label": "retry until maxAttempts = 2",
      "variant": "dashed",
      "fromSide": "bottom",
      "toSide": "bottom"
    },
    {
      "id": "dead-letter",
      "from": "worker",
      "to": "dead-letter",
      "label": "final failure → dead-letter",
      "variant": "dashed",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "complete",
      "from": "worker",
      "to": "queue",
      "label": "finally: active--, pump()",
      "variant": "dashed",
      "fromSide": "left",
      "toSide": "bottom"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Request path",
      "items": [
        "submitJob validates tenant and payload",
        "Accepted jobs return status 202 with a jobId",
        "Queue pump starts work while active < 3"
      ]
    },
    {
      "dot": "emerald",
      "title": "Worker contract",
      "items": [
        "Each attempt authorizes the tenant",
        "Billing provider receives payload and token",
        "Successful results are saved to job-result-store"
      ]
    },
    {
      "dot": "rose",
      "title": "Failure path",
      "items": [
        "The worker retries through maxAttempts = 2",
        "After the final failed attempt it returns a dead-letter record with after = 3",
        "Completion decrements active and pumps the next waiting job"
      ]
    }
  ]
}