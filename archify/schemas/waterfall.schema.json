{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tt-a1i/archify/schemas/waterfall.schema.json",
  "title": "Archify Execution Waterfall",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "diagram_type",
    "meta",
    "spans"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "diagram_type": {
      "const": "waterfall"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "evidence"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "$ref": "common.schema.json#/$defs/locale"
        },
        "subtitle": {
          "type": "string"
        },
        "output": {
          "type": "string"
        },
        "animation": {
          "$ref": "common.schema.json#/$defs/animation"
        },
        "visual_preset": {
          "$ref": "common.schema.json#/$defs/visualPreset"
        },
        "quality_profile": {
          "$ref": "common.schema.json#/$defs/qualityProfile"
        },
        "repository": {
          "$ref": "common.schema.json#/$defs/repository"
        },
        "views": {
          "$ref": "common.schema.json#/$defs/guidedViews"
        },
        "evidence": {
          "enum": [
            "measured",
            "illustrative"
          ],
          "description": "Whether span timing is recorded measurement or illustrative input; drawn on the canvas."
        },
        "unit": {
          "enum": [
            "us",
            "ms",
            "s"
          ],
          "description": "Unit of every start, end, and duration; defaults to ms."
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "number",
          "minimum": 360,
          "description": "Width of the time axis in px."
        }
      }
    },
    "spans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "start"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "number",
            "minimum": 0,
            "description": "Offset from the trace origin, in meta.unit."
          },
          "end": {
            "type": "number",
            "minimum": 0
          },
          "duration": {
            "type": "number",
            "minimum": 0
          },
          "parent": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "status": {
            "enum": [
              "ok",
              "error",
              "cancelled",
              "incomplete"
            ]
          },
          "service": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string"
          },
          "sources": {
            "$ref": "common.schema.json#/$defs/sourceReferences"
          }
        }
      }
    },
    "cards": {
      "$ref": "common.schema.json#/$defs/cards"
    }
  }
}
