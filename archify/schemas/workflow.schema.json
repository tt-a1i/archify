{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tt-a1i/archify/schemas/workflow.schema.json",
  "title": "Archify Workflow Diagram",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "diagram_type",
    "meta",
    "lanes",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "diagram_type": {
      "const": "workflow"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "$ref": "common.schema.json#/$defs/locale"
        },
        "types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "color"],
            "properties": {
              "id": { "$ref": "common.schema.json#/$defs/id" },
              "label": { "type": "string", "minLength": 1, "maxLength": 32 },
              "color": { "enum": ["cyan", "green", "violet", "amber", "rose", "orange", "slate"] }
            }
          }
        },
        "edgeStates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "color"],
            "properties": {
              "id": { "$ref": "common.schema.json#/$defs/id" },
              "color": { "enum": ["cyan", "green", "violet", "amber", "rose", "orange", "slate"] },
              "label": { "type": "string", "minLength": 1, "maxLength": 24 },
              "dash": { "type": "boolean" }
            }
          }
        },
        "reader": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "store": { "type": "boolean" },
            "slots": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "kind"],
                "properties": {
                  "id": { "$ref": "common.schema.json#/$defs/id" },
                  "kind": { "enum": ["flag", "point", "text", "time", "minutes"] },
                  "label": { "type": "string", "minLength": 1, "maxLength": 24 },
                  "cue": { "type": "string", "minLength": 1, "maxLength": 4 },
                  "maxLength": { "type": "integer", "minimum": 1, "maximum": 2000 }
                }
              }
            },
            "view": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "dim": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 4,
                  "items": { "$ref": "#/$defs/readerViewTarget" }
                },
                "stow": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 4,
                  "items": { "$ref": "#/$defs/readerViewTarget" }
                },
                "solo": { "type": "boolean" }
              }
            },
            "clock": {
              "type": "object",
              "additionalProperties": false,
              "required": ["rule", "anchor", "at"],
              "properties": {
                "rule": { "$ref": "common.schema.json#/$defs/id" },
                "anchor": { "$ref": "common.schema.json#/$defs/id" },
                "at": { "$ref": "common.schema.json#/$defs/id" },
                "dwell": { "$ref": "common.schema.json#/$defs/id" }
              }
            },
            "suppress": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": { "enum": ["chapter_delta"] }
            }
          }
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind"],
            "properties": {
              "id": { "$ref": "common.schema.json#/$defs/id" },
              "kind": { "enum": ["accumulate", "window", "sum", "require", "compare"] },
              "left": { "type": "string", "minLength": 1, "maxLength": 40 },
              "right": { "type": "string", "minLength": 1, "maxLength": 40 },
              "op": { "enum": ["eq", "lte", "gte"] },
              "field": { "type": "string", "minLength": 1, "maxLength": 40 },
              "min": { "type": "number" },
              "max": { "type": "number" },
              "on": { "enum": ["node", "edge", "lane"] },
              "missing": { "enum": ["skip", "error"] },
              "expect": { "type": "number" },
              "tolerance": { "type": "number", "minimum": 0 },
              "scope": { "enum": ["node", "edge", "all", "chain"] },
              "seeds": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["start", "base"],
                  "properties": {
                    "start": { "$ref": "common.schema.json#/$defs/id" },
                    "base": {
                      "oneOf": [
                        { "type": "number" },
                        { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" }
                      ]
                    }
                  }
                }
              },
              "add": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "node": { "type": "string", "minLength": 1, "maxLength": 40 },
                  "edge": { "type": "string", "minLength": 1, "maxLength": 40 }
                }
              },
              "render": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "edge": { "type": "string", "minLength": 1, "maxLength": 40 },
                  "lane": { "type": "string", "minLength": 1, "maxLength": 40 },
                  "caption": { "type": "string", "minLength": 1, "maxLength": 40 }
                }
              },
              "wrap": {
                "type": "object",
                "additionalProperties": false,
                "required": ["at"],
                "properties": {
                  "at": { "type": "number", "minimum": 1 },
                  "label": { "type": "string", "maxLength": 12 }
                }
              },
              "limit": {
                "type": "object",
                "additionalProperties": false,
                "required": ["max"],
                "properties": { "max": { "type": "number" } }
              }
            }
          }
        },
        "labels": { "$ref": "common.schema.json#/$defs/labels" },
        "bands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "from",
              "to"
            ],
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "from": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              },
              "to": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              }
            }
          }
        },
        "subtitle": {
          "type": "string"
        },
        "output": {
          "type": "string"
        },
        "animation": {
          "enum": [
            "trace",
            "none"
          ]
        },
        "visual_preset": {
          "enum": [
            "classic",
            "signal-flow",
            "blueprint",
            "editorial"
          ]
        },
        "quality_profile": {
          "enum": [
            "standard",
            "showcase"
          ]
        },
        "views": {
          "$ref": "common.schema.json#/$defs/guidedViews"
        },
        "legend": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "$ref": "common.schema.json#/$defs/legendMode" },
            "entries": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "frontend": { "$ref": "common.schema.json#/$defs/legendEntry" },
                "backend": { "$ref": "common.schema.json#/$defs/legendEntry" },
                "database": { "$ref": "common.schema.json#/$defs/legendEntry" },
                "cloud": { "$ref": "common.schema.json#/$defs/legendEntry" },
                "security": { "$ref": "common.schema.json#/$defs/legendEntry" },
                "messagebus": { "$ref": "common.schema.json#/$defs/legendEntry" },
                "external": { "$ref": "common.schema.json#/$defs/legendEntry" }
              }
            }
          }
        },
        "viewBox": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 700
            },
            {
              "type": "number",
              "minimum": 240
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "variant": {
            "enum": [
              "normal",
              "exception"
            ]
          }
        }
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "fromCol": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "toCol": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "from": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "to": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "variant": {
            "enum": [
              "default",
              "emphasis",
              "security",
              "dashed"
            ]
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "lane"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "lane": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "fromCol": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "toCol": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "from": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "to": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "variant": {
            "enum": [
              "default",
              "emphasis",
              "security",
              "dashed"
            ]
          }
        }
      }
    },
    "mainPath": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "semanticChecks": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "allowedRoots": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          }
        },
        "allowedTerminals": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          }
        },
        "requiredEdges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/semanticRelation"
          }
        },
        "requiredPaths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/semanticRelation"
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "lane",
          "type",
          "label"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "lane": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "col": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "sublabel": {
            "type": "string"
          },
          "tag": {
            "type": "string"
          },
          "brand": {
            "$ref": "common.schema.json#/$defs/brandMark"
          },
          "width": {
            "type": "number",
            "minimum": 32
          },
          "height": {
            "type": "number",
            "minimum": 32
          },
          "yOffset": {
            "type": "number"
          },
        "facts": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "propertyNames": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$", "maxLength": 40 },
          "additionalProperties": { "type": "number", "minimum": -1000000000000, "maximum": 1000000000000 }
        },
          "links": { "$ref": "common.schema.json#/$defs/links" },
          "media": {
            "type": "object",
            "additionalProperties": false,
            "required": ["href"],
            "properties": {
              "href": {
                "type": "string",
                "minLength": 8,
                "maxLength": 4000000,
                "anyOf": [
                  { "pattern": "^https?://" },
                  { "pattern": "^data:image/" }
                ]
              },
              "alt": { "type": "string", "maxLength": 80 }
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "from": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "to": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "label": {
            "type": "string"
          },
          "variant": {
            "$ref": "common.schema.json#/$defs/variant"
          },
          "state": { "$ref": "common.schema.json#/$defs/id" },
          "role": {
            "enum": [
              "main",
              "branch",
              "async",
              "return",
              "error"
            ]
          },
          "fromSide": {
            "$ref": "#/$defs/side"
          },
          "toSide": {
            "$ref": "#/$defs/side"
          },
          "route": {
            "enum": [
              "auto",
              "straight",
              "drop",
              "outside-right",
              "return-left",
              "bottom-channel",
              "up-channel"
            ]
          },
          "via": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/point"
            }
          },
          "labelAt": {
            "$ref": "common.schema.json#/$defs/point"
          },
          "labelDx": {
            "type": "number"
          },
          "labelDy": {
            "type": "number"
          },
          "labelSegment": {
            "type": "integer",
            "minimum": 0
          },
          "channelX": {
            "type": "number"
          },
          "channelY": {
            "type": "number"
          },
          "bias": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "width": {
            "type": "number",
            "minimum": 0.5
          },
        "facts": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "propertyNames": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$", "maxLength": 40 },
          "additionalProperties": { "type": "number", "minimum": -1000000000000, "maximum": 1000000000000 }
        },
          "links": { "$ref": "common.schema.json#/$defs/links" }
        }
      }
    },
    "cards": {
      "$ref": "common.schema.json#/$defs/cards"
    }
  },
  "$defs": {
    "readerViewTarget": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/id" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["slot"],
          "properties": {
            "slot": { "$ref": "common.schema.json#/$defs/id" },
            "reach": { "enum": ["self", "before"] }
          }
        }
      ]
    },
    "semanticRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "to": {
          "$ref": "common.schema.json#/$defs/id"
        }
      }
    },
    "side": {
      "enum": [
        "left",
        "right",
        "top",
        "bottom"
      ]
    }
  }
}
