{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tt-a1i/archify/schemas/pr-pack.schema.json",
  "title": "Archify PR Diagram Pack Manifest",
  "description": "Declares which change-marked diagrams a pull request review pack renders, the exact revisions they describe, and the objective statistics the Markdown may repeat. It never carries a risk verdict.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "title", "views"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "pr-pack" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "summary": { "type": "string", "maxLength": 2000 },
    "repository": {
      "description": "Repository URL or owner/name used for source links.",
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "baseRef": { "type": "string", "minLength": 1, "maxLength": 200 },
    "headRef": { "type": "string", "minLength": 1, "maxLength": 200 },
    "baseSha": { "$ref": "#/$defs/sha" },
    "headSha": { "$ref": "#/$defs/sha" },
    "platform": { "enum": ["github", "gitlab", "generic"] },
    "theme": { "enum": ["both", "light", "dark"] },
    "preset": { "$ref": "common.schema.json#/$defs/visualPreset" },
    "nodeBadges": { "enum": ["labeled", "compact"] },
    "stats": {
      "description": "Objective counts only (for example filesChanged, additions, deletions, nodesAdded). Values are non-negative integers.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-zA-Z0-9]*$" },
      "additionalProperties": { "type": "integer", "minimum": 0 },
      "maxProperties": 24
    },
    "views": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "type", "input"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "title": { "type": "string", "minLength": 1, "maxLength": 160 },
          "caption": { "type": "string", "maxLength": 600 },
          "type": {
            "enum": ["architecture", "workflow", "sequence", "dataflow", "lifecycle", "erd", "class", "tree", "timeline", "waterfall"]
          },
          "input": {
            "description": "Diagram JSON path relative to the manifest file.",
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.json$"
          },
          "collapsed": { "type": "boolean" },
          "storyOnly": {
            "type": "boolean",
            "description": "Render for story composition without emitting a standalone image in Markdown or uploading as a separate attachment."
          },
          "theme": { "enum": ["both", "light", "dark"] },
          "preset": { "$ref": "common.schema.json#/$defs/visualPreset" }
        }
      }
    },
    "changes": {
      "description": "Optional change table rows. Long tables fold into <details> past changeTableLimit.",
      "type": "array",
      "maxItems": 400,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject", "change"],
        "dependencies": { "line": ["path"], "baseLine": ["path"], "basePath": ["path"] },
        "properties": {
          "path": { "$ref": "#/$defs/sourcePath" },
          "basePath": { "$ref": "#/$defs/sourcePath" },
          "line": { "type": "integer", "minimum": 1 },
          "baseLine": { "type": "integer", "minimum": 1 },
          "subject": { "type": "string", "minLength": 1, "maxLength": 160 },
          "kind": { "type": "string", "minLength": 1, "maxLength": 40 },
          "change": { "$ref": "common.schema.json#/$defs/changeStatus" },
          "detail": { "type": "string", "maxLength": 400 },
          "view": { "$ref": "common.schema.json#/$defs/id" }
        }
      }
    },
    "changeTableLimit": { "type": "integer", "minimum": 1, "maximum": 100 },
    "story": { "$ref": "#/$defs/prStory" }
  },
  "$defs": {
    "sourcePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\)(?!.*[\\u0000-\\u001f\\u007f])(?!.*(?:^|/)\\.\\.?(?:/|$))(?!\\.git(?:/|$))(?!.*//)(?!.*\\/$).+$"},
    "sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "prStory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration", "stages", "steps"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "caption": { "type": "string", "maxLength": 600 },
        "duration": { "type": "number", "minimum": 6, "maximum": 120 },
        "loop": { "type": "boolean" },
        "nodeBadges": { "enum": ["labeled", "compact"] },
        "stages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["view"],
            "properties": {
              "view": { "$ref": "common.schema.json#/$defs/id" },
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        },
        "pair": {
          "type": "object",
          "additionalProperties": false,
          "required": ["before", "after", "at", "shared"],
          "properties": {
            "before": { "$ref": "common.schema.json#/$defs/id" },
            "after": { "$ref": "common.schema.json#/$defs/id" },
            "at": { "type": "number", "minimum": 0 },
            "until": { "type": "number", "exclusiveMinimum": 0 },
            "duration": { "type": "number", "minimum": 0.3, "maximum": 5 },
            "shared": {
              "type": "array",
              "minItems": 1,
              "maxItems": 24,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id"],
                "properties": {
                  "id": { "$ref": "common.schema.json#/$defs/id" },
                  "label": { "type": "string", "minLength": 1, "maxLength": 120 },
                  "subtitle": { "type": "string", "minLength": 1, "maxLength": 120 }
                }
              }
            }
          }
        },
        "relabel": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["view", "node", "subtitle", "at"],
            "properties": {
              "view": { "$ref": "common.schema.json#/$defs/id" },
              "node": { "$ref": "common.schema.json#/$defs/id" },
              "subtitle": { "type": "string", "minLength": 1, "maxLength": 120 },
              "at": { "type": "number", "minimum": 0 }
            }
          }
        },
        "enter": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["view", "nodes", "at"],
            "properties": {
              "view": { "$ref": "common.schema.json#/$defs/id" },
              "nodes": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "common.schema.json#/$defs/id" }
              },
              "at": { "type": "number", "minimum": 0 },
              "stagger": { "type": "number", "minimum": 0, "maximum": 5 }
            }
          }
        },
        "connect": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["view", "edges", "at"],
            "properties": {
              "view": { "$ref": "common.schema.json#/$defs/id" },
              "edges": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "at": { "type": "number", "minimum": 0 },
              "stagger": { "type": "number", "minimum": 0, "maximum": 5 }
            }
          }
        },
        "fade": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["view", "at", "to"],
            "properties": {
              "view": { "$ref": "common.schema.json#/$defs/id" },
              "nodes": {
                "type": "array",
                "items": { "$ref": "common.schema.json#/$defs/id" }
              },
              "edges": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "at": { "type": "number", "minimum": 0 },
              "to": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "focus": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["view", "nodes", "at"],
            "properties": {
              "view": { "$ref": "common.schema.json#/$defs/id" },
              "nodes": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "common.schema.json#/$defs/id" }
              },
              "at": { "type": "number", "minimum": 0 },
              "area": { "enum": ["center", "left"] }
            }
          }
        },
        "traces": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["view", "edges", "times"],
            "properties": {
              "id": { "$ref": "common.schema.json#/$defs/id" },
              "view": { "$ref": "common.schema.json#/$defs/id" },
              "edges": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "times": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "number", "minimum": 0 }
              },
              "end": { "type": "number", "exclusiveMinimum": 0 },
              "travel": { "type": "number", "minimum": 0.3, "maximum": 5 }
            }
          }
        },
        "metrics": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["view", "node", "label", "before", "after", "at"],
            "properties": {
              "id": { "$ref": "common.schema.json#/$defs/id" },
              "view": { "$ref": "common.schema.json#/$defs/id" },
              "node": { "$ref": "common.schema.json#/$defs/id" },
              "label": { "type": "string", "minLength": 1, "maxLength": 60 },
              "before": {
                "anyOf": [
                  { "type": "number" },
                  { "type": "string", "minLength": 1, "maxLength": 40 }
                ]
              },
              "after": {
                "anyOf": [
                  { "type": "number" },
                  { "type": "string", "minLength": 1, "maxLength": 40 }
                ]
              },
              "at": { "type": "number", "minimum": 0 },
              "slot": { "enum": ["left", "center", "right"] },
              "tone": { "enum": ["accent", "neutral"] }
            }
          }
        },
        "detail": {
          "type": "object",
          "additionalProperties": false,
          "required": ["view", "nodes", "start", "end", "title", "path"],
          "properties": {
            "view": { "$ref": "common.schema.json#/$defs/id" },
            "nodes": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "common.schema.json#/$defs/id" }
            },
            "start": { "type": "number", "minimum": 0 },
            "end": { "type": "number", "exclusiveMinimum": 0 },
            "mode": { "enum": ["excerpt", "diff"] },
            "title": { "type": "string", "minLength": 1, "maxLength": 120 },
            "note": { "type": "string", "maxLength": 200 },
            "path": { "type": "string", "minLength": 1, "maxLength": 240 },
            "basePath": { "type": "string", "minLength": 1, "maxLength": 240 },
            "revision": { "enum": ["head", "base"] },
            "baseLines": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": { "type": "integer", "minimum": 1 }
            },
            "lines": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": { "type": "integer", "minimum": 1 }
            },
            "maxLines": { "type": "integer", "minimum": 3, "maximum": 16 },
            "highlight": {
              "type": "array",
              "items": { "type": "integer", "minimum": 1 }
            },
            "selections": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["at"],
                "properties": {
                  "at": { "type": "number", "minimum": 0 },
                  "baseLines": {
                    "type": "array",
                    "items": { "type": "integer", "minimum": 1 }
                  },
                  "lines": {
                    "type": "array",
                    "items": { "type": "integer", "minimum": 1 }
                  }
                }
              }
            }
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "body"],
            "dependencies": { "line": ["path"], "baseLine": ["path"] },
            "properties": {
              "path": { "$ref": "#/$defs/sourcePath" },
              "line": { "type": "integer", "minimum": 1 },
              "baseLine": { "type": "integer", "minimum": 1 },
              "at": { "type": "number", "minimum": 0 },
              "title": { "type": "string", "minLength": 1, "maxLength": 120 },
              "body": { "type": "string", "minLength": 1, "maxLength": 240 },
              "change": { "$ref": "common.schema.json#/$defs/changeStatus" }
            }
          }
        }
      }
    }
  }
}
