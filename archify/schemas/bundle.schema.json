{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tt-a1i/archify/schemas/bundle.schema.json",
  "title": "Archify Diagram Bundle Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_type", "entry", "diagrams"],
  "properties": {
    "schema_version": { "const": 1 },
    "bundle_type": { "const": "drilldown" },
    "entry": { "$ref": "common.schema.json#/$defs/id" },
    "max_depth": { "const": 2 },
    "diagrams": {
      "type": "array",
      "minItems": 1,
      "maxItems": 13,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "file", "diagram_type", "title", "level", "spec_sha256", "artifact_sha256"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "file": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.html$" },
          "diagram_type": { "$ref": "common.schema.json#/$defs/diagramTypeName" },
          "title": { "type": "string", "minLength": 1 },
          "level": { "type": "integer", "minimum": 0, "maximum": 1 },
          "node_count": { "type": "integer", "minimum": 1, "maximum": 12 },
          "spec_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "drilldowns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["parent", "component", "child"],
        "properties": {
          "parent": { "$ref": "common.schema.json#/$defs/id" },
          "component": { "$ref": "common.schema.json#/$defs/id" },
          "child": { "$ref": "common.schema.json#/$defs/id" },
          "label": { "type": "string", "minLength": 1, "maxLength": 80 }
        }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256"],
      "properties": {
        "file": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.ownership\\.json$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
