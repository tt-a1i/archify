{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "findings.schema.json",
  "title": "Bauify findings",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "rules", "summary", "diagnostics"],
  "properties": {
    "schema_version": { "const": 1 },
    "repository": { "type": "object" },
    "rules": { "type": "array", "items": { "type": "string" } },
    "externalEvidence": {
      "type": "array",
      "description": "Captured repository text cited by external reports, beyond the selected AST extractor's files.",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "sourceText", "sha256"],
        "properties": { "path": { "type": "string", "minLength": 1 }, "sourceText": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["errors", "warnings", "info", "suppressed"],
      "properties": {
        "errors": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "info": { "type": "integer", "minimum": 0 },
        "suppressed": { "type": "integer", "minimum": 0 }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analyzer", "language", "adapter", "configDigest", "ruleVersions", "coverage"],
      "description": "What the findings depend on besides the source: analyzer version, effective configuration, rules run and scan coverage. Optional so findings written before it existed stay valid; a comparison with such a run is reported as not verifiable.",
      "properties": {
        "analyzer": { "type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": { "name": { "type": "string" }, "version": { "type": "string" } } },
        "language": { "type": ["string", "null"] },
        "adapter": { "type": ["string", "null"] },
        "adapterRevision": { "type": ["integer", "null"], "minimum": 1, "description": "Revision of the adapter's extraction logic (raw facts repository.adapterRevision); null when the facts did not record one." },
        "configDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "sha256 of the effective (merged) configuration in its key order, schema_version excluded." },
        "ruleVersions": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 }, "description": "Rules that ran (suppressed rules excluded) and the version of their logic." },
        "external": { "type": "array", "items": { "$ref": "#/$defs/externalSource" } },
        "goBuildScope": {
          "type": "object", "additionalProperties": false,
          "description": "Effective Go source selection, including environment/host defaults. Optional for historical findings; absent scope makes a Go comparison unknown unless another difference is known.",
          "required": ["goos", "goarch", "cgo", "tests", "tags", "releaseTags", "toolTags"],
          "properties": {
            "goos": { "type": "string" }, "goarch": { "type": "string" },
            "cgo": { "type": "boolean" }, "tests": { "type": "boolean" },
            "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
            "releaseTags": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
            "toolTags": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
          }
        },
        "duplicates": {
          "type": "object", "additionalProperties": false,
          "required": ["engine", "settings", "coverage"],
          "properties": {
            "engine": {
              "type": "object", "additionalProperties": false,
              "required": ["name", "version", "adapterRevision"],
              "properties": { "name": { "const": "jscpd" }, "version": { "type": "string" }, "adapterRevision": { "type": "integer", "minimum": 1 } }
            },
            "settings": {
              "type": "object", "additionalProperties": false,
              "required": ["mode", "identifiers", "minTokens", "minLines", "maxFileBytes"],
              "properties": {
                "mode": { "const": "weak" }, "identifiers": { "enum": ["exact", "consistent"] },
                "minTokens": { "type": "integer", "minimum": 1 }, "minLines": { "type": "integer", "minimum": 1 },
                "maxFileBytes": { "type": "integer", "minimum": 1 }
              }
            },
            "coverage": {
              "type": "object", "additionalProperties": false,
              "required": ["selected", "analyzed", "omitted", "complete"],
              "properties": {
                "selected": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
                "analyzed": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
                "omitted": { "type": "array", "items": {
                  "type": "object", "additionalProperties": false, "required": ["file", "reason"],
                  "properties": { "file": { "type": "string" }, "reason": { "enum": ["vendored", "parse-error", "unsupported-format", "max-file-bytes", "not-reported-by-engine"] } }
                } },
                "complete": { "type": "boolean" }
              }
            }
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["files", "excludedRoles", "parseErrors"],
          "properties": {
            "files": { "type": ["integer", "null"], "minimum": 0 },
            "excludedRoles": { "type": "array", "items": { "type": "string" } },
            "parseErrors": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "code", "dimension", "severity", "confidence", "message", "subject", "evidence", "supportedFixes"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z]{2,4}-(?:[0-9a-f]{12}|[0-9]{4,})$", "description": "Stable id: dimension prefix + 12 hex digits of a hash of the rule and subject. Findings written before stable ids used a position number (COUP-0001); those stay valid schema-v1 documents but their ids cannot be matched across runs." },
          "code": { "type": "string", "pattern": "^[a-z-]+/[a-z-]+$" },
          "dimension": { "enum": ["coupling", "architecture", "complexity", "redundancy", "error-handling", "impact", "ai-smell", "conventions", "external-review"] },
          "severity": { "enum": ["error", "warning", "info"] },
          "confidence": { "enum": [1, 0.7, 0.5, null] },
          "message": { "type": "string", "minLength": 1 },
          "subject": { "type": "object" },
          "evidence": { "type": "object" },
          "external": { "$ref": "#/$defs/externalDiagnostic" },
          "supportedFixes": { "type": "array", "items": { "type": "string" } },
          "evidenceDigest": {
            "type": "object",
            "additionalProperties": false,
            "required": ["files", "sha256"],
            "description": "Hash over the source text of only the files this finding is about; present when raw facts were available. A changed digest means the evidence must be re-checked.",
            "properties": {
              "files": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "lines": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 1 }, "description": "For a function finding: the first and last line hashed." },
              "ranges": {
                "type": "array",
                "minItems": 1,
                "description": "Each cited line envelope, including separate ranges in the same file. The aggregate hash covers file, snippet hash and capturedOccurrences in this order, excluding positions.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["file", "startLine", "endLine", "sha256", "capturedOccurrences"],
                  "properties": {
                    "file": { "type": "string", "minLength": 1 },
                    "startLine": { "type": "integer", "minimum": 1 },
                    "endLine": { "type": "integer", "minimum": 1 },
                    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                    "capturedOccurrences": { "type": "integer", "minimum": 1 }
                  }
                }
              },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        },
        "allOf": [{ "if": { "required": ["external"] }, "then": { "properties": { "confidence": { "const": null } } }, "else": { "properties": { "evidence": { "type": "object", "required": ["threshold"] }, "confidence": { "enum": [1, 0.7, 0.5] } } } }]
      }
    }
  },
  "$defs": {
    "externalLocation": {
      "type": "object", "required": ["file"],
      "properties": {
        "role": { "enum": ["primary", "related"], "description": "SARIF distinguishes result locations from related source context." },
        "file": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 }, "endLine": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 }, "endColumn": { "type": "integer", "minimum": 1 }
      }
    },
    "externalDiagnostic": {
      "type": "object",
      "required": ["sourceId", "tool", "ruleId", "originalSeverity", "reportPointer", "identityRevision", "binding", "reviewDigest", "locations"],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 }, "tool": { "type": "string", "minLength": 1 },
        "ruleId": { "type": ["string", "null"] }, "originalSeverity": { "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "null" }] },
        "severityDefaulted": { "type": "boolean" }, "helpUri": { "type": "string" }, "reportPointer": { "type": "string" },
        "identityRevision": { "type": "integer", "minimum": 1 }, "fingerprint": { "type": "string" },
        "binding": { "enum": ["verified", "unverified", "changed"] },
        "reviewDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "comparisonLineSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "locations": { "type": "array", "items": { "$ref": "#/$defs/externalLocation" } },
        "origin": { "type": "object" }, "suggestions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "externalSource": {
      "type": "object",
      "required": ["id", "format", "tool", "toolVersion", "adapterRevision", "identityRevision", "reportSha256", "configDigest", "status", "coverage", "binding", "suppressed", "notices"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "code": { "type": "string", "pattern": "^[a-z-]+/[a-z-]+$" }, "format": { "enum": ["eslint", "ruff", "sarif", "github-review"] },
        "tool": { "type": "string", "minLength": 1 }, "toolVersion": { "type": ["string", "null"] },
        "adapterRevision": { "type": "integer", "minimum": 1 }, "identityRevision": { "type": "integer", "minimum": 1 },
        "reportSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "configDigest": { "type": ["string", "null"] },
        "status": { "enum": ["imported", "partial"] }, "binding": { "enum": ["verified", "unverified", "changed"] },
        "coverage": { "type": "object", "required": ["files", "complete"], "properties": { "files": { "type": "array", "items": { "type": "string" } }, "complete": { "type": ["boolean", "null"] } } },
        "suppressed": { "type": "integer", "minimum": 0 }, "notices": { "type": "array", "items": { "type": "object", "required": ["code", "message"], "properties": { "code": { "type": "string" }, "message": { "type": "string" } } } },
        "command": { "type": "string" }, "reportFile": { "type": "string" },
        "severityPolicy": { "enum": ["source", "warning"] },
        "importSettingsDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sourceHashes": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
        "sourceTextHashes": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
      }
    }
  }
}
