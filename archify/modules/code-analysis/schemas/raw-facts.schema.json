{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "raw-facts.schema.json",
  "title": "Archify Analyzers raw facts",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "files", "imports", "symbols", "calls", "unresolved"],
  "properties": {
    "schema_version": { "const": 1 },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "revision", "language", "adapter"],
      "properties": {
        "root": { "type": "string", "minLength": 1, "description": "Analyzed directory, relative to the Git repository root (\".\" when equal)." },
        "revision": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40}$" },
        "url": { "type": ["string", "null"], "description": "Git origin URL as configured; null when there is no Git repository or no origin." },
        "language": { "enum": ["ts", "py"] },
        "adapter": { "type": "string" }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "loc", "role"],
        "properties": {
          "path": { "$ref": "#/$defs/repoPath" },
          "loc": { "type": "integer", "minimum": 0 },
          "role": { "enum": ["source", "test", "generated"] }
        }
      }
    },
    "imports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "specifier", "kind", "line", "resolved"],
        "properties": {
          "from": { "$ref": "#/$defs/repoPath" },
          "to": { "$ref": "#/$defs/repoPath", "description": "Present only when resolved inside the analyzed tree." },
          "specifier": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["static", "dynamic", "require", "export"] },
          "line": { "type": "integer", "minimum": 1 },
          "resolved": { "type": "boolean" },
          "names": { "type": "array", "items": { "type": "string" } },
          "lazy": { "const": true, "description": "Import occurs in a deferred body. Its caller may still run during module initialization; this is not a safety guarantee." },
          "typeOnly": { "const": true, "description": "Type-only dependency, excluded from runtime import-cycle analysis." },
          "conditional": { "const": true, "description": "Execution depends on a guard, exception, or loop not evaluated by the analyzer." },
          "implicit": { "const": true, "description": "Python package initializer loaded by this import; line points to the initiating statement." }
        },
        "if": { "properties": { "resolved": { "const": true } } },
        "then": { "required": ["to"] },
        "else": { "not": { "required": ["to"] } },
        "allOf": [{
          "if": { "required": ["implicit"] },
          "then": { "properties": { "resolved": { "const": true } } }
        }]
      }
    },
    "symbols": {
      "type": "array",
      "description": "Module-scope bindings per file (Python adapter): the line where a name becomes bound at import time. Used to identify potential partial-initialization risks in import cycles; static binding order does not prove runtime failure. Empty for adapters that do not emit them.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "name", "kind", "line"],
        "properties": {
          "file": { "$ref": "#/$defs/repoPath" },
          "name": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["function", "class", "variable", "import"] },
          "line": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "calls": { "type": "array", "description": "Reserved for M2 (Call Graph).", "items": { "type": "object" } },
    "parse_errors": {
      "type": "array",
      "description": "Files the adapter could not parse; they keep their file record but contribute no imports.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "message"],
        "properties": { "path": { "$ref": "#/$defs/repoPath" }, "message": { "type": "string" } }
      }
    },
    "unresolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["external", "outside", "unknown", "opaque"],
      "properties": {
        "external": { "type": "integer", "minimum": 0, "description": "Bare or node: specifiers." },
        "outside": { "type": "integer", "minimum": 0, "description": "Resolved to a file outside the analyzed root." },
        "unknown": { "type": "integer", "minimum": 0, "description": "Path-like specifier that could not be resolved." },
        "opaque": { "type": "integer", "minimum": 0, "description": "Dynamic import/require whose specifier is not a string literal (recorded as \"<computed>\")." }
      }
    }
  },
  "$defs": {
    "repoPath": { "type": "string", "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[^\\\\\\u0000-\\u001f]+$" }
  }
}
